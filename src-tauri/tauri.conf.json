{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muller",
  "version": "0.1.4",
  "identifier": "app.muller.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Muller",
        "width": 1360,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": true,
        "focus": true,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "installer.nsh"
      }
    },
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
